# Neon Postgres - from your Neon project's connection string (pooled connection is fine)
DATABASE_URL="postgres://user:password@ep-xxxx.neon.tech/lineup?sslmode=require"

# Clerk - from your Clerk application's API Keys page
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# Optional. Only needed if this app is on a custom domain - used so coach invitation emails
# link back into the app instead of Clerk's default hosted pages. Without it, this is worked
# out automatically from Vercel's own environment variables (or localhost when running
# locally), so most setups can leave this blank.
NEXT_PUBLIC_APP_URL=""

# Pusher Channels - from your Pusher app's "App Keys" page (used for live updates between coaches)
PUSHER_APP_ID="xxxxx"
NEXT_PUBLIC_PUSHER_KEY="xxxxxxxxxxxxxxxxxxxx"
PUSHER_SECRET="xxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# Only needed to run scripts/import-from-sheets.ts (a one-time Sheets -> Postgres import)
# Create a Google Cloud service account, share your Hub Sheet + every team Sheet with its email
# (Viewer is enough), and download its JSON key.
GOOGLE_SERVICE_ACCOUNT_JSON="./service-account.json"
SHEETS_HUB_SPREADSHEET_ID=""
IMPORT_TARGET_ORG_ID=""
IMPORT_TARGET_ADMIN_USER_ID=""
